# ---------------------------------------------
# 🛠️ FUNÇÃO SUPER SSHFS (Genérica e Otimizada)
# ---------------------------------------------
function montar-server() {
    # Define onde vai montar (Padrão: pasta RemoteServer na sua Home)
    local MOUNT_POINT="$HOME/RemoteServer"
    
    # Opções de Performance para Mac M1 (Cache, Compressão, KeepAlive)
    local OPTS="-o Reconnect,ServerAliveInterval=15,ServerAliveCountMax=3,cache=yes,kernel_cache,compression=yes,Ciphers=aes128-ctr,defer_permissions,noappledouble,volname=RemoteDrive"

    # Variáveis
    local KEY_OPT=""
    local USER=""
    local IP=""
    local REMOTE_PATH=""

    # Lógica: Detecta se passou 3 ou 4 argumentos
    if [[ $# -eq 4 ]]; then
        # 4 argumentos: O primeiro é a chave .pem
        echo "🔑 Usando chave: $1"
        KEY_OPT="-o IdentityFile=$1"
        USER=$2
        IP=$3
        REMOTE_PATH=$4
    elif [[ $# -eq 3 ]]; then
        # 3 argumentos: Sem chave (vai pedir senha ou usar chave padrão)
        USER=$1
        IP=$2
        REMOTE_PATH=$3
    else
        echo "❌ Uso incorreto!"
        echo "   Com chave: montar-server chave.pem usuario ip /caminho"
        echo "   Sem chave: montar-server usuario ip /caminho"
        return 1
    fi

    # Cria a pasta se não existir
    if [ ! -d "$MOUNT_POINT" ]; then
        mkdir -p "$MOUNT_POINT"
    fi

    # Garante que está desmontado antes de tentar
    umount -f "$MOUNT_POINT" 2>/dev/null

    echo "🔌 Conectando a $USER@$IP:$REMOTE_PATH..."
    
    # O Comando Mágico
    sshfs $OPTS $KEY_OPT "$USER@$IP:$REMOTE_PATH" "$MOUNT_POINT"

    # Verifica se deu certo
    if [ $? -eq 0 ]; then
        echo "✅ Sucesso! Acessível em: $MOUNT_POINT"
        # Abre a pasta no Finder para confirmar (opcional)
        # open "$MOUNT_POINT"
    else
        echo "💥 Falha ao montar. Verifique os dados."
    fi
}

# Atalho para desmontar
alias desmontar-server="diskutil unmount force ~/RemoteServer 2>/dev/null || umount -f ~/RemoteServer && echo '🗑️ Desmontado!'"

